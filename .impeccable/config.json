{
  "hook": {
    "enabled": true,
    "limits": {
      "maxFindings": 5,
      "maxChars": 8000
    }
  },
  "detector": {
    "extensions": [
      {
        "ext": ".heex",
        "engine": "html"
      },
      {
        "ext": ".eex",
        "engine": "html"
      },
      {
        "ext": ".ex",
        "engine": "text"
      }
    ],
    "ignoreFiles": [
      "deps/**",
      "_build/**",
      "priv/static/**"
    ]
  }
}
