{"content":"<div data-wiki-template=\"pokemon-v4\" style=\"max-width: 800px; margin: 0 auto; font-family: Poppins, sans-serif;\">\n\n<h1 style=\"color: #f2f6fd; border-bottom: 2px solid #3aa6f6; padding-bottom: 10px;\">Bulbasaur</h1>\n\n<div style=\"text-align: center; margin: 20px 0;\">\n  <img src=\"/pokemon/001.png\" alt=\"Bulbasaur\" style=\"max-width: 200px; image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges; user-select: none; pointer-events: none;\" />\n\n  <div style=\"margin-top: 10px; padding: 8px;\">\n    <img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 64px; height: 64px; margin: 0 4px; vertical-align: middle;\" /><img src=\"/elements/8.png\" alt=\"poison\" title=\"Poison\" style=\"width: 64px; height: 64px; margin: 0 4px; vertical-align: middle;\" />\n  </div>\n</div>\n\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">📖 Descrição da Pokédex</h2>\n  <p style=\"margin-bottom: 0; line-height: 1.7;\">A strange seed was planted on its back at birth. The plant sprouts and grows with this Pokemon.</p>\n</div>\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">📊 Informações Básicas</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr style=\"background: rgba(58, 166, 246, 0.14);\">\n      <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Atributo</th>\n      <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Valor</th>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">❤️ HP</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>600</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">⭐ Experiência</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>900</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🎓 Nível necessário</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>1</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🏅 Tier</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>6</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🎯 Função</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>PVE</strong></td>\n    </tr>\n  </table>\n</div>\n\n<!-- pokemon-evolution:start -->\n<div data-wiki-section=\"pokemon-evolution\" style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">✨ Evolução</h2>\n  <h3 style=\"color: #b8dcff; margin: 4px 0 10px; font-size: 1rem;\">Pode evoluir para</h3>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px;\">\n    <div style=\"background: rgba(7, 13, 27, 0.56); border: 1px solid rgba(126, 158, 204, 0.22); border-radius: 10px; padding: 14px;\">\n      <div style=\"display: flex; align-items: center; justify-content: center; flex-wrap: nowrap; gap: 12px; margin-bottom: 14px;\">\n        <a href=\"/gen/1/001_bulbasaur\" title=\"Abrir Bulbasaur\" style=\"display: inline-flex; flex-direction: column; align-items: center; gap: 7px; min-width: 104px; max-width: 150px; color: inherit; text-decoration: none;\"><span style=\"display: flex; align-items: center; justify-content: center; width: 104px; height: 76px; border-radius: 12px; background: radial-gradient(circle, rgba(58, 166, 246, 0.16), rgba(7, 13, 27, 0.2) 70%);\"><img src=\"/api/assets/evolution-pokemon/001.png\" alt=\"Bulbasaur\" width=\"96\" height=\"69\" loading=\"lazy\" decoding=\"async\" style=\"width: 96px; height: 69px; object-fit: contain; image-rendering: pixelated;\" /></span><strong style=\"color: #f2f6fd; text-align: center; line-height: 1.25;\">Bulbasaur</strong></a>\n        <span aria-hidden=\"true\" style=\"color: #3aa6f6; font-size: 1.5rem; flex: 0 0 auto;\">→</span>\n        <a href=\"/gen/1/002_ivysaur\" title=\"Abrir Ivysaur\" style=\"display: inline-flex; flex-direction: column; align-items: center; gap: 7px; min-width: 104px; max-width: 150px; color: inherit; text-decoration: none;\"><span style=\"display: flex; align-items: center; justify-content: center; width: 104px; height: 76px; border-radius: 12px; background: radial-gradient(circle, rgba(58, 166, 246, 0.16), rgba(7, 13, 27, 0.2) 70%);\"><img src=\"/api/assets/evolution-pokemon/002.png\" alt=\"Ivysaur\" width=\"96\" height=\"69\" loading=\"lazy\" decoding=\"async\" style=\"width: 96px; height: 69px; object-fit: contain; image-rendering: pixelated;\" /></span><strong style=\"color: #f2f6fd; text-align: center; line-height: 1.25;\">Ivysaur</strong></a>\n      </div>\n      <div style=\"font-size: 0.9rem; color: #a9bad3; margin-bottom: 5px;\">Level do Pokémon: <strong style=\"color: #f2f6fd;\">40</strong></div>\n      <div style=\"font-size: 0.9rem; color: #a9bad3;\">Itens necessários:</div>\n      <div style=\"display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 6px;\"><span style=\"display: inline-flex; align-items: center; gap: 7px; height: 40px; box-sizing: border-box; padding: 4px 10px 4px 5px; margin: 0; vertical-align: top; border-radius: 999px; background: rgba(58, 166, 246, 0.11); border: 1px solid rgba(58, 166, 246, 0.3); color: #dbeaff; font-size: 0.88rem;\"><span style=\"display: inline-flex; align-items: center; justify-content: center; flex: 0 0 30px; width: 30px; height: 30px;\"><img src=\"/api/assets/evolution-items/38611.png\" alt=\"\" width=\"30\" height=\"30\" loading=\"lazy\" decoding=\"async\" style=\"max-width: 30px; max-height: 30px; object-fit: contain; image-rendering: pixelated;\" /></span><span style=\"display: inline-flex; align-items: center; height: 30px; line-height: 1.2;\">Leaf Stone</span></span></div>\n    </div>\n  </div>\n</div>\n<!-- pokemon-evolution:end -->\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <div class=\"pokemon-moves-heading\">\n    <h2 style=\"color: #b8dcff; margin: 0;\">⚔️ Ataques &amp; Magias</h2>\n    <pokemon-combat-mode></pokemon-combat-mode>\n  </div>\n  <div style=\"overflow-x: auto;\">\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr style=\"background: rgba(58, 166, 246, 0.14);\">\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Slot</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Nome</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Cooldown</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Elemento</th>\n      </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M1</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Tackle</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">12s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/1.png\" alt=\"normal\" title=\"Normal\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M2</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Razor Leaf</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">10s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M3</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Vine Whip</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">12s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M4</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Grass Knot</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">15s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M5</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Leech Seed</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">20s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M6</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Solar Beam</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">30s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M7</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Stun Spore</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">30s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/4.png\" alt=\"grass\" title=\"Grass\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M8</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Poison Powder</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">20s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/8.png\" alt=\"poison\" title=\"Poison\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    </table>\n  </div>\n</div>\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">🧭 Habilidades</h2>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 4px;\"><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Cut</span><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Strength</span><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Headbutt</span></div>\n</div>\n\n\n</div>\n","path":"gen/1/001_bulbasaur"}