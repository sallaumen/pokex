{"content":"<div data-wiki-template=\"pokemon-v4\" style=\"max-width: 800px; margin: 0 auto; font-family: Poppins, sans-serif;\">\n\n<h1 style=\"color: #f2f6fd; border-bottom: 2px solid #3aa6f6; padding-bottom: 10px;\">Mewtwo</h1>\n\n<div style=\"text-align: center; margin: 20px 0;\">\n  <img src=\"/pokemon/150.png\" alt=\"Mewtwo\" style=\"max-width: 200px; image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges; user-select: none; pointer-events: none;\" />\n\n  <div style=\"margin-top: 10px; padding: 8px;\">\n    <img src=\"/elements/11.png\" alt=\"psychic\" title=\"Psychic\" style=\"width: 64px; height: 64px; margin: 0 4px; vertical-align: middle;\" />\n  </div>\n</div>\n\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">📖 Descrição da Pokédex</h2>\n  <p style=\"margin-bottom: 0; line-height: 1.7;\">No description.</p>\n</div>\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">📊 Informações Básicas</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr style=\"background: rgba(58, 166, 246, 0.14);\">\n      <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Atributo</th>\n      <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Valor</th>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">❤️ HP</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>180</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">⭐ Experiência</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>12000</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🎓 Nível necessário</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>120</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🏅 Tier</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>1</strong></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">🎯 Função</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>PVE</strong></td>\n    </tr>\n  </table>\n</div>\n\n<!-- pokemon-evolution:start -->\n<div data-wiki-section=\"pokemon-evolution\" style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">✨ Evolução</h2>\n  <p style=\"margin: 0; color: #a9bad3; line-height: 1.6;\">Este Pokémon não possui evolução cadastrada.</p>\n</div>\n<!-- pokemon-evolution:end -->\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <div class=\"pokemon-moves-heading\">\n    <h2 style=\"color: #b8dcff; margin: 0;\">⚔️ Ataques &amp; Magias</h2>\n    <pokemon-combat-mode></pokemon-combat-mode>\n  </div>\n  <div style=\"overflow-x: auto;\">\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr style=\"background: rgba(58, 166, 246, 0.14);\">\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Slot</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Nome</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Cooldown</th>\n        <th style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.22); text-align: left; color: #b8dcff;\">Elemento</th>\n      </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M1</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Psybeam</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">15s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/11.png\" alt=\"psychic\" title=\"Psychic\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M2</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Psywave</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">20s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/11.png\" alt=\"psychic\" title=\"Psychic\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M3</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Shadow Ball</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">12s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/14.png\" alt=\"ghost\" title=\"Ghost\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M4</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Confusion</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">30s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/11.png\" alt=\"psychic\" title=\"Psychic\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>M5</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><strong>Psychic</strong></td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\">30s</td>\n      <td style=\"padding: 10px; border: 1px solid rgba(126, 158, 204, 0.18);\"><img src=\"/elements/11.png\" alt=\"psychic\" title=\"Psychic\" style=\"width: 24px; height: 24px; vertical-align: middle; image-rendering: pixelated;\" /></td>\n    </tr>\n    </table>\n  </div>\n</div>\n\n<div style=\"background: linear-gradient(145deg, #111a2e 0%, #0d1426 100%); padding: 20px; border-radius: 12px; margin: 18px 0; border: 1px solid rgba(58, 166, 246, 0.28);\">\n  <h2 style=\"color: #b8dcff; margin-top: 0;\">🧭 Habilidades</h2>\n  <div style=\"display: flex; flex-wrap: wrap; gap: 4px;\"><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Rock Smash</span><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Fly</span><span style=\"display: inline-block; background: rgba(58, 166, 246, 0.12); border: 1px solid rgba(58, 166, 246, 0.34); border-radius: 999px; padding: 7px 12px; margin: 4px;\">Strength</span></div>\n</div>\n\n\n</div>\n","path":"gen/1/150_mewtwo"}